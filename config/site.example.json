{
  "$comment": "Copy to config/site.json (gitignored) and mount it at /config/site.json. Every section is optional; a tool whose section is missing says so instead of guessing.",

  "clusters": {
    "prod": {
      "api": "https://k8s.example.com",
      "grafana": "https://grafana.example.com",
      "alerts": true,
      "emergency": { "host": "203.0.113.10", "port": 22, "user": "root", "kubectl": "kubectl" }
    },
    "dr": {
      "api": "https://k8s-dr.example.com",
      "grafana": "https://grafana-dr.example.com",
      "emergency": { "host": "203.0.113.30", "port": 22, "user": "root", "kubectl": "k0s kubectl" }
    }
  },
  "defaultCluster": "prod",

  "gitlab": { "url": "https://gitlab.example.com" },

  "s3": {
    "cluster": "prod",
    "endpoint": "https://s3.example.com",
    "region": "us-east-1",
    "secret": { "namespace": "storage", "name": "s3-credentials" }
  },

  "debugHosts": {
    "debug": { "host": "203.0.113.40", "port": 22, "user": "root" }
  },

  "routers": {
    "gateway": {
      "label": "site gateway",
      "vaultSlug": "mikrotik-gateway__api",
      "publicAddress": "198.51.100.1",
      "lan": "10.0.0.0/24",
      "writableLists": ["edge-allowlist"]
    }
  },

  "sshKnownHosts": "/config/ssh_known_hosts"
}
