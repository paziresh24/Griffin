{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "inbounds": [
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 8118,
      "protocol": "http",
      "settings": {}
    },
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    },
    {
      "tag": "cursor-door",
      "listen": "127.0.0.1",
      "port": 18743,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "<ADDRESS>",
        "port": 443,
        "network": "tcp"
      }
    },
    {
      "tag": "probe-proxy-cursor",
      "listen": "127.0.0.1",
      "port": 10811,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    },
    {
      "tag": "probe-proxy-cursor-fb1",
      "listen": "127.0.0.1",
      "port": 10812,
