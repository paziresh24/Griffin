# Copy to deploy/.env on the host. Paths are host paths; compose mounts them.
# The real .env is never in git.

# Which optional services compose starts. "infra" adds Griffin's own egress proxy,
# OpenBao and the unsealer; leave it empty if the host already runs those. Add "tools"
# (e.g. tools,infra) for the broker and its sandbox shell.
COMPOSE_PROFILES=infra

GRIFFIN_PORT=3100
GRIFFIN_UID=1000
GRIFFIN_GID=1000

# Host paths
GRIFFIN_DATA=/srv/griffin/data
GRIFFIN_WORKSPACE=/srv/griffin/workspace
GRIFFIN_CONFIG=/srv/griffin/config
# Secrets are set in the UI (Settings → Secrets) or `griffin secrets`; they live in encrypted boxes
# in the data dir and the broker-data volume. OpenBao (profile "infra") is optional; only then:
GRIFFIN_VAULT_DIR=/srv/griffin/vault
GRIFFIN_VAULT_TOKEN_AGE=/srv/griffin/vault/state/machine.token.age
GRIFFIN_AGE_IDENTITY=/srv/griffin/keys/identity.age
# profile "tools": debug_exec's sandbox (its own key and a persistent /root live here)
GRIFFIN_SANDBOX_DIR=/srv/griffin/sandbox
# GRIFFIN_SANDBOX_PORT=2222

# Egress proxy (profile "infra" runs Xray from this directory; see deploy/xray/)
GRIFFIN_XRAY_DIR=/srv/griffin/xray
GRIFFIN_PROXY=http://127.0.0.1:18118
GRIFFIN_PROXY_PORT=18118
# Telegram MTProto needs SOCKS, not HTTP
GRIFFIN_TELEGRAM_SOCKS=127.0.0.1:18180

# Where the UI is reachable; chart and file links in messenger replies point here.
GRIFFIN_PUBLIC_URL=https://griffin.example.com
# Former host names (comma-separated) that should redirect to GRIFFIN_PUBLIC_URL
# OLD_HOSTS=old.example.com

# Model engines: add accounts and their keys in Settings → Engines (or `griffin engines`);
# keys go to the encrypted secret store. Everything below is only the env fallback, and most of it
# can also be set in Settings → Configuration (`griffin config`), which wins over these.
# Older installs: key files on the data volume (mode 0600) still work:
#   $GRIFFIN_DATA/cursor.api-key      Cursor Agent SDK
#   $GRIFFIN_DATA/anthropic.api-key   Claude Agent SDK
# CURSOR_MODEL=auto
# CLAUDE_MODEL=sonnet
# Any OpenAI-compatible endpoint; key in data/openai.api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=medium
# OWNER_NAME=Sara
# The assistant's own name on this install (empty = Griffin)
# ASSISTANT_NAME=
# ASSISTANT_LATIN=
# Model for colleague threads and the subtasks they delegate (empty = the agent profile)
# TEAM_PROVIDER=claude
# TEAM_MODEL=opus
# TEAM_SUB_PROVIDER=claude
# TEAM_SUB_MODEL=sonnet
# New web chats start on this repo under $GRIFFIN_WORKSPACE/repos (empty = no repo)
# DEFAULT_REPO=
# Owner chats idle this many days are archived (default 3, 0 = never)
# CHAT_IDLE_DAYS=3
# What colleagues can do without Griffin ({user} = their id), sent once to their agent:
# PEER_SELF_SERVE=Your kubeconfig: secret store project {user}, key KUBECONFIG. Config of every app: your GitOps repo.

# Incident ops room: shadow (LLM triage, nobody messaged) | record (group + show, no LLM) | off
OPS_MODE=record
