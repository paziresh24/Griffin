{
  "name": "griffin",
  "description": "Self-hosted platform for a small team of AI agents: your agents, your tools, your box. Claude, Cursor or any OpenAI-compatible model.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/timeline",
    "apps/server",
    "apps/broker",
    "apps/web"
  ],
  "bin": {
    "griffin": "bin/griffin.mjs"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace apps/web",
    "griffin": "node bin/griffin.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://paziresh24.github.io/Griffin/",
  "repository": {
    "type": "git",
    "url": "https://github.com/paziresh24/Griffin.git"
  },
  "keywords": [
    "ai-agent",
    "ai-assistant",
    "multi-agent",
    "self-hosted",
    "agent-platform",
    "mcp",
    "claude",
    "cursor",
    "openai-compatible",
    "telegram-bot",
    "llm",
    "open-source"
  ]
}
